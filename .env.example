# ---------------------------------------------------------------------------
# ProbaSight environment
#
# Copy to .env.local and fill in. .env.local is gitignored.
# Anything NOT prefixed with NEXT_PUBLIC_ stays on the server and is never
# included in the browser bundle.
# ---------------------------------------------------------------------------

# --- Server-only secrets ---------------------------------------------------

# Panta developer API key: pk_test_... or pk_live_...
# Obtain: register at https://docs.panta.market/quickstart then mint a key via
# POST /account/keys/. The plaintext secret is shown only once, on creation.
# REQUIRED. Without it, every Panta-backed surface returns PANTA_NOT_CONFIGURED.
PANTA_API_KEY=

# Panta API base URL. Defaults to production when unset.
PANTA_API_BASE_URL=https://live-api.panta.market/api/v1

# Groq API key for AI Market Intelligence.
# Obtain: https://console.groq.com/keys
# OPTIONAL. Without it, only the AI panel is unavailable; everything else works.
GROQ_API_KEY=

# Groq model id. Defaults to openai/gpt-oss-120b when unset (verified live).
# Do NOT use a groq/compound* model: those have built-in web search, which would
# break the guarantee that analysis is grounded only in the Panta snapshot.
GROQ_MODEL=openai/gpt-oss-120b

# --- Public (browser-visible) configuration --------------------------------

# Solana RPC endpoint used to broadcast and confirm signed transactions.
# The public default is heavily rate-limited; use a dedicated RPC (Helius,
# QuickNode, Triton, Alchemy) for anything beyond casual testing.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# mainnet-beta | devnet | testnet. Drives explorer links only.
# Panta's live API operates against mainnet.
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
